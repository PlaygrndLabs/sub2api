{
  "name": "sub2api",
  "description": "A Cloudflare-based LLM gateway and proxy server: the CLIProxyAPI (CPA) project deployed as a Cloudflare Worker in one click.",
  "license": "MIT",
  "homepage": "https://github.com/PlaygrndLabs/sub2api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlaygrndLabs/sub2api.git"
  },
  "bugs": {
    "url": "https://github.com/PlaygrndLabs/sub2api/issues"
  },
  "keywords": [
    "cliproxyapi",
    "cpa",
    "cloudflare-workers",
    "cloudflare-containers",
    "claude-code",
    "llm-gateway",
    "llm-proxy",
    "ai-gateway",
    "openai-compatible",
    "anthropic",
    "codex",
    "gemini",
    "self-hosted"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "types": "wrangler types --include-env=false",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test",
    "deploy": "node scripts/check-plan.mjs && node scripts/deploy-config.mjs && wrangler deploy --config wrangler.deploy.json"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "cloudflare": {
    "bindings": {
      "DASHBOARD_PASSWORD": {
        "description": "Password for access to the dashboard. This install needs the Workers Paid plan."
      }
    }
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
