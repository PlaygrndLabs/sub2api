{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "./worker-configuration.d.ts"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "worker/src",
    "worker/test",
    "scripts/move-to-container",
    "test",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "exclude": [
    "test/s3-server.ts",
    "worker/test/sqlite.ts",
    "worker/test/account.test.ts",
    "worker/test/management.test.ts",
    "worker/test/codex.test.ts",
    "worker/test/usage.test.ts",
    "worker/test/vertex.test.ts",
    "worker/test/kimi.test.ts"
  ]
}
