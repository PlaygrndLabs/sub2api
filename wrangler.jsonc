{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sub2api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "name": "sub2api",
      "class_name": "Cpa",
      "image": "./container/Dockerfile",
      "image_build_context": "./container",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CPA", "class_name": "Cpa" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Cpa"] }],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "sub2api" }],
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
